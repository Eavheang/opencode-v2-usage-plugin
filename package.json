{
  "name": "@howaboua/opencode-usage-plugin",
  "version": "0.1.10",
  "description": "opencode plugin for tracking AI provider usage, rate limits, and quotas",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "usage",
    "tracking",
    "rate-limit"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-17963",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "bun test",
    "prepublishOnly": "npm run build",
    "publish:dev": "npm publish --tag dev",
    "release:dev": "npm version prerelease --preid dev && npm publish --tag dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
